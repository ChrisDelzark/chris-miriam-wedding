{
  "platform": {
    "apiRuntime": "node:20"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "routes": [
    {
      "route": "/cm-2026-admin-us*",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex"
      }
    }
  ]
}
